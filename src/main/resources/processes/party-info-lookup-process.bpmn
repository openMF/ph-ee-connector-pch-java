<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0">
  <bpmn:process id="party-info-lookup-process" name="Party Information Lookup Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PartyLookup" name="Start Party Lookup">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_PartyLookup" name="Lookup Party Information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="vnext-party-lookup" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PartyLookupResult" name="Lookup Successful?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_PartyLookup" targetRef="ServiceTask_PartyLookup" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_PartyLookup" targetRef="Gateway_PartyLookupResult" />
    <bpmn:sequenceFlow id="Flow_3" name="Success" sourceRef="Gateway_PartyLookupResult" targetRef="EndEvent_PartySuccess">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=executionStatus</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="Failure" sourceRef="Gateway_PartyLookupResult" targetRef="EndEvent_PartyFailure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(executionStatus)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_PartySuccess" name="Party Lookup Successful">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_PartyFailure" name="Party Lookup Failed">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="party-info-lookup-process">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_PartyLookup">
        <dc:Bounds x="173" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="164" y="146" width="53" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_PartyLookup_di" bpmnElement="ServiceTask_PartyLookup">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PartyLookupResult_di" bpmnElement="Gateway_PartyLookupResult" isMarkerVisible="true">
        <dc:Bounds x="420" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="415" y="57.5" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PartySuccess_di" bpmnElement="EndEvent_PartySuccess">
        <dc:Bounds x="602" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="587" y="146" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PartyFailure_di" bpmnElement="EndEvent_PartyFailure">
        <dc:Bounds x="602" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="587" y="236" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="209" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="420" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="470" y="120" />
        <di:waypoint x="602" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="95" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="445" y="145" />
        <di:waypoint x="445" y="210" />
        <di:waypoint x="602" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="193" width="34" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
